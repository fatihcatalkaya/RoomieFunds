		"@sveltejs/kit": "^2.44.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/vite": "^4.0.14",
		"daisyui": "^5.0.3",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-svelte": "^3.9.1",
		"prettier": "^3.5.3",
