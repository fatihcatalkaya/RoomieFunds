# Copy to .env.local to point the frontend at a different Keycloak.
# Both are optional: `vite dev` defaults to the docker-compose Keycloak
# (http://localhost:9090/realms/roomiefunds) and `vite build` to production.

# VITE_OIDC_ISSUER_URI=http://localhost:9090/realms/roomiefunds
# VITE_OIDC_CLIENT_ID=roomiefunds-frontend
